# Copy to .env (never commit it) and load with: set -a; source .env; set +a
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
# Identifier of the Auth0 API (Applications -> APIs) used for /api/** endpoints
AUTH0_AUDIENCE=https://techtut-auth0-api
STEP_UP_MAX_AGE=10m
